// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  Cliente
  Abogado
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  passwordHash      String?
  role              Role     @default(Cliente)
  firstName         String
  lastName          String
  googleId          String?
  registrationDate  DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  documentNumber    String?  @unique
  documentType      String?
  familyId          String?
  family            FamilyNucleus? @relation("FamilyMembers", fields: [familyId], references: [id])
  adminOf           FamilyNucleus? @relation("FamilyAdmin")
  documentsUploaded Boolean  @default(false)

  @@map("users")
}

model FamilyNucleus {
  id            String   @id @default(uuid())
  name          String
  adminId       String   @unique
  admin         User     @relation("FamilyAdmin", fields: [adminId], references: [id])
  members       User[]   @relation("FamilyMembers")
  driveFolderId String?  // ID de la carpeta en Google Drive
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("family_nuclei")
}
