# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development # development | production

# -----------------------------------------------------------------------------
# AUTHENTICATION (JWT)
# -----------------------------------------------------------------------------
# Genera una cadena aleatoria larga (puedes usar: openssl rand -base64 32)
JWT_SECRET=tu_secreto_super_seguro_aqui
JWT_EXPIRES_IN=24h

# -----------------------------------------------------------------------------
# GOOGLE CLOUD SERVICE ACCOUNT (Sheets, Drive, Vision API)
# -----------------------------------------------------------------------------
# Cómo obtener:
# 1. Ve a Google Cloud Console (https://console.cloud.google.com/)
# 2. Crea un proyecto o selecciona uno existente.
# 3. Ve a "IAM y administración" > "Cuentas de servicio".
# 4. Crea una cuenta, ve a "Claves" > "Agregar clave" > "Crear clave nueva" (JSON).
# 5. El JSON descargado contiene estos datos:

GOOGLE_PROJECT_ID=tu-proyecto-id
GOOGLE_CLIENT_EMAIL=tu-cuenta-servicio@tu-proyecto.iam.gserviceaccount.com

# IMPORTANTE: La clave privada debe ir entre comillas y los saltos de línea (\n) se manejan internamente en google.ts
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_AQUI\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# GOOGLE LOGIN (OAuth 2.0)
# -----------------------------------------------------------------------------
# Cómo obtener:
# 1. En Google Cloud Console, ve a "APIs y servicios" > "Credenciales".
# 2. Crea un "ID de cliente de OAuth 2.0" de tipo "Aplicación web".
GOOGLE_CLIENT_ID=tu-cliente-id-de-google.apps.googleusercontent.com
# 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
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# DATABASE & STORAGE (Google Sheets & Drive)
# -----------------------------------------------------------------------------
# GOOGLE_SPREADSHEET_ID: El ID se encuentra en la URL de tu hoja de cálculo:
# https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SPREADSHEET_ID=id_de_tu_hoja_de_calculo

# GOOGLE_DRIVE_CLIENTS_ROOT_ID: El ID de la carpeta principal en Drive donde se guardarán los expedientes.
# Se encuentra al final de la URL al abrir la carpeta en el navegador.
# RECUERDA: Debes compartir esta carpeta con el 'GOOGLE_CLIENT_EMAIL' (Cuenta de Servicio) con permiso de Editor.
GOOGLE_DRIVE_CLIENTS_ROOT_ID=id_de_la_carpeta_raiz_en_drive

# -----------------------------------------------------------------------------
# MYSQL DATABASE (User Identity Storage)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=migratory_db
DB_PORT=3306

# URL de conexión para Prisma
DATABASE_URL="mysql://root:tu_contraseña@localhost:3306/migratory_db"
