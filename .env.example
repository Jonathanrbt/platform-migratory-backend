# -----------------------------------------------------------------------------
# CONFIGURACIÓN DEL SERVIDOR
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development # development | production

# -----------------------------------------------------------------------------
# AUTENTICACIÓN (JWT)
# -----------------------------------------------------------------------------
# Genera una cadena aleatoria larga (puedes usar: openssl rand -base64 32)
JWT_SECRET=tu_secreto_super_seguro_aqui
JWT_EXPIRES_IN=24h

# -----------------------------------------------------------------------------
# CUENTA DE SERVICIO DE GOOGLE CLOUD (Sheets, Drive, Vision API)
# -----------------------------------------------------------------------------
# Cómo obtener:
# 1. Ve a Google Cloud Console (https://console.cloud.google.com/)
# 2. Crea un proyecto o selecciona uno existente.
# 3. Ve a "IAM y administración" > "Cuentas de servicio".
# 4. Crea una cuenta, ve a "Claves" > "Agregar clave" > "Crear clave nueva" (JSON).
# 5. El JSON descargado contiene estos datos:

GOOGLE_PROJECT_ID=tu-proyecto-id
GOOGLE_CLIENT_EMAIL=tu-cuenta-servicio@tu-proyecto.iam.gserviceaccount.com

# IMPORTANTE: La clave privada debe ir entre comillas y los saltos de línea (\n) se manejan internamente en google.ts
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_AQUI\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# INICIO DE SESIÓN DE GOOGLE Y ACCESO A DRIVE (OAuth 2.0)
# -----------------------------------------------------------------------------
# Cómo obtener CLIENT_ID y CLIENT_SECRET:
# 1. En Google Cloud Console (https://console.cloud.google.com/), ve a "APIs y servicios" > "Credenciales".
# 2. Crea un "ID de cliente de OAuth 2.0" (Tipo: Aplicación web).
# 3. En la configuración del cliente, obtén estos dos valores:

GOOGLE_CLIENT_ID=tu-cliente-id-de-google.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-secreto-de-cliente-de-google
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Cómo obtener REFRESH_TOKEN (Para acceso persistente a Drive):
# 1. Ve a https://developers.google.com/oauthplayground/
# 2. Haz clic en el engranaje (Settings) -> Marca "Use your own OAuth credentials".
# 3. Ingresa tu GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET.
# 4. En el Paso 1, busca y selecciona "Drive API v3" (https://www.googleapis.com/auth/drive).
# 5. Haz clic en "Authorize APIs", inicia sesión con tu cuenta y permite los accesos.
# 6. En el Paso 2, haz clic en "Exchange authorization code for tokens".
# 7. Copia el valor de "Refresh token" resultante:

GOOGLE_REFRESH_TOKEN=tu-refresh-token-de-google
# -----------------------------------------------------------------------------


# -----------------------------------------------------------------------------
# BASE DE DATOS Y ALMACENAMIENTO (Google Sheets & Drive)
# -----------------------------------------------------------------------------
# GOOGLE_SPREADSHEET_ID: El ID se encuentra en la URL de tu hoja de cálculo:
# https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SPREADSHEET_ID=id_de_tu_hoja_de_calculo

# GOOGLE_DRIVE_CLIENTS_ROOT_ID: El ID de la carpeta principal en Drive donde se guardarán los expedientes.
# Se encuentra al final de la URL al abrir la carpeta en el navegador.
# RECUERDA: Debes compartir esta carpeta con el 'GOOGLE_CLIENT_EMAIL' (Cuenta de Servicio) con permiso de Editor.
GOOGLE_DRIVE_CLIENTS_ROOT_ID=id_de_la_carpeta_raiz_en_drive

# -----------------------------------------------------------------------------
# BASE DE DATOS MYSQL (Almacenamiento de Identidad de Usuarios)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_contraseña
DB_NAME=migratory_db
DB_PORT=3306

# URL de conexión para Prisma
DATABASE_URL="mysql://root:tu_contraseña@localhost:3306/migratory_db"

# -----------------------------------------------------------------------------
# SERVICIO DE CORREO ELECTRÓNICO (Resend)
# -----------------------------------------------------------------------------
SMTP_FROM="Plataforma Migratoria <notificaciones@tu-dominio.example>"
RESEND_API_KEY="tu-api-key-de-resend"