# -----------------------------------------------------------------------------
# CONFIGURACIÓN DEL SERVIDOR
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development # development | production

# -----------------------------------------------------------------------------
# AUTENTICACIÓN (JWT)
# -----------------------------------------------------------------------------
# Genera una cadena aleatoria larga (puedes usar: openssl rand -base64 32)
JWT_SECRET=tu_secreto_super_seguro_aqui
JWT_EXPIRES_IN=24h

# -----------------------------------------------------------------------------
# CUENTA DE SERVICIO DE GOOGLE (Sheets, Drive, Vision API)
# -----------------------------------------------------------------------------
# Cómo obtener:
# 1. Ve a Google Cloud Console (https://console.cloud.google.com/)
# 2. Crea un proyecto o selecciona uno existente.
# 3. Ve a "IAM y administración" > "Cuentas de servicio".
# 4. Crea una cuenta, ve a "Claves" > "Agregar clave" > "Crear clave nueva" (JSON).
# 5. El JSON descargado contiene estos datos:

GOOGLE_PROJECT_ID=tu-proyecto-id
GOOGLE_CLIENT_EMAIL=tu-cuenta-servicio@tu-proyecto.iam.gserviceaccount.com

# IMPORTANTE: La clave privada debe ir entre comillas y los saltos de línea (\n) se manejan internamente
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_AQUI\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# INICIO DE SESIÓN DE GOOGLE Y ACCESO A DRIVE (OAuth 2.0)
# -----------------------------------------------------------------------------
# Cómo obtener CLIENT_ID y CLIENT_SECRET:
# 1. En Google Cloud Console > "APIs y servicios" > "Credenciales".
# 2. Crea un "ID de cliente de OAuth 2.0" (Tipo: Aplicación web).
# 3. Authorized redirect URIs debe incluir GOOGLE_REDIRECT_URI exacto.
# 4. Authorized JavaScript origins debe incluir FRONTEND_URL (Vercel / localhost).

GOOGLE_CLIENT_ID=tu-cliente-id-de-google.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-secreto-de-cliente-de-google

# Local:
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
# Producción (Render + Vercel):
# GOOGLE_REDIRECT_URI=https://<tu-servicio>.onrender.com/api/v1/auth/google/callback
# FRONTEND_URL=https://<tu-app>.vercel.app

# Cómo obtener REFRESH_TOKEN (acceso persistente a Drive):
# 1. Ve a https://developers.google.com/oauthplayground/
# 2. Settings -> "Use your own OAuth credentials".
# 3. Ingresa GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET.
# 4. Paso 1: selecciona Drive API v3 (https://www.googleapis.com/auth/drive).
# 5. Authorize APIs -> Exchange authorization code for tokens.
# 6. Copia el Refresh token:

GOOGLE_REFRESH_TOKEN=tu-refresh-token-de-google

# -----------------------------------------------------------------------------
# GOOGLE WORKSPACE (Sheets & Drive) — almacenamiento de expedientes
# -----------------------------------------------------------------------------
# GOOGLE_SPREADSHEET_ID: ID en la URL de la hoja:
# https://docs.google.com/spreadsheets/d/ESTE_ES_EL_ID/edit
GOOGLE_SPREADSHEET_ID=id_de_tu_hoja_de_calculo

# GOOGLE_DRIVE_CLIENTS_ROOT_ID: ID de la carpeta raíz de expedientes en Drive.
# Comparte esa carpeta con GOOGLE_CLIENT_EMAIL (Editor).
GOOGLE_DRIVE_CLIENTS_ROOT_ID=id_de_la_carpeta_raiz_en_drive

# -----------------------------------------------------------------------------
# GEMINI AI
# -----------------------------------------------------------------------------
GEMINI_API_KEY=tu-api-key-de-gemini

# -----------------------------------------------------------------------------
# BASE DE DATOS POSTGRESQL (Supabase)
# -----------------------------------------------------------------------------
# Dashboard: https://supabase.com/dashboard/project/<ref>/settings/database
#
# DATABASE_URL  → Transaction pooler (puerto 6543) para la app en runtime
# DIRECT_URL    → Session pooler (puerto 5432) o host directo para migraciones Prisma
#
# Nota: el host db.<ref>.supabase.co puede ser solo IPv6; en ese caso usa el
# session pooler de Supavisor como DIRECT_URL.

DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require"

# -----------------------------------------------------------------------------
# SERVICIO DE CORREO ELECTRÓNICO (Resend)
# -----------------------------------------------------------------------------
SMTP_FROM="Plataforma Migratoria <notificaciones@tu-dominio.example>"
RESEND_API_KEY="tu-api-key-de-resend"
